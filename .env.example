# Option 1 (Direct Static Deploy — Vite / Netlify / Cloudflare / GitHub Pages):
# Paste your deployed Google Apps Script Web App URL below:
VITE_WEBHOOK_URL=

# Optional secret token matching Apps Script Property `WEBHOOK_TOKEN`:
VITE_WEBHOOK_TOKEN=

# Option 2 (Recommended for Vercel Production — zero Safari CORS issues + hidden token):
# Set VITE_API_ENDPOINT=/api/register and configure GOOGLE_SHEETS_WEBHOOK_URL on Vercel.
VITE_API_ENDPOINT=
